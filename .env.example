# =====================================================================
# TOLKFLOW ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env (never commit secrets or real API keys)
# =====================================================================

# Gemini AI Services
GEMINI_API_KEY=

# Authentication & OTP Cryptography Secrets
# Recommended: 32+ byte random hex strings
AUTH_SESSION_SECRET=
OTP_HMAC_SECRET=

# Optional Persistent SQLite Database File Path (defaults to .data/tolkflow.db)
DB_PATH=

# ---------------------------------------------------------------------
# Email Delivery Configuration (Configure AT LEAST ONE provider below)
# ---------------------------------------------------------------------

# Sender Identity (Required for all providers)
EMAIL_FROM=TOLKFLOW Security <no-reply@tolkflow.io>

# Option 1: Resend API
RESEND_API_KEY=

# Option 2: SendGrid API
SENDGRID_API_KEY=

# Option 3: Standard SMTP (via Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------
# Payment Gateway Integrations (Backend-only — NEVER prefix with VITE_)
# ---------------------------------------------------------------------

# Public App URL (used for MTN MoMo callback & checkout return URLs)
APP_BASE_URL=http://localhost:3000

# MTN MoMo Collections API (Rwanda / Africa)
# Set MTN_MOMO_ENV=sandbox for testing or MTN_MOMO_ENV=mtnrwanda for live
MTN_MOMO_ENV=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_CALLBACK_SECRET=

# Stripe (International Visa / Mastercard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (International Checkout)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Flutterwave (Regional Africa & Cards)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Verified Exchange Rate API
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_API_KEY=

